{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "sfo1"
  ],
  "functions": {
    "app/api/mcp/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/[job]/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/snapshot_seguidores",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/post_scraper_grilla",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/kit_suscriptores",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/go_leads",
      "schedule": "10 13 * * *"
    }
  ]
}
