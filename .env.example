# Supabase (proyecto ContentOS, us-west-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo server; nunca al cliente
SUPABASE_JWT_SECRET=                  # solo si el proyecto conserva el secreto legacy HS256 (ver PLAN.md hallazgo 7)

# MCP
MCP_KEY_PEPPER=                       # sal para sha256(api_key || pepper); 32+ bytes aleatorios

# Import de Notion (una sola vez)
NOTION_TOKEN=

# Negocio
TZ=America/Mexico_City

# Webhooks entrantes (Supabase Database Webhooks → /api/hooks/*)
HOOKS_SECRET=
# URL pública (Vercel); en local se infiere del host
NEXT_PUBLIC_SITE_URL=
